+#[allow(clippy::too_many_arguments)]
+fn construct_solution_adaptive(
+    parts: &[PreparedPart],
+    cfg: &Config,
+    container: &Container,
+    cap: usize,
+    attempt: usize,
+    deadline: Instant,
+    runner: &Runner,
+) -> anyhow::Result<Option<Solution>> {
+    let mut groups: HashMap<(usize, u64), VecDeque<usize>> = HashMap::new();
+    for part_index in 0..parts.len() {
+        let flip_class = usize::from(!(cfg.optimize_flip_face && parts[part_index].part.two_sided));
+        groups
+            .entry((flip_class, parts[part_index].shape_key))
+            .or_default()
+            .push_back(part_index);
+    }
+
+    let mut solution = Solution {
+        sheets: vec![],
+        strategy: format!("mn_adaptive_family_cap_{cap}"),
+        attempt,
+    };
+    let mut remaining = parts.len();
+    let mut step = 0usize;
+
+    while remaining > 0 {
+        if runner.cancelled() {
+            anyhow::bail!("CANCELLED");
+        }
+        if Instant::now() >= deadline {
+            return Ok(None);
+        }
+
+        let active_flip = groups
+            .iter()
+            .filter(|(_, queue)| !queue.is_empty())
+            .map(|(key, _)| key.0)
+            .min()
+            .unwrap_or(1);
+        let mut representatives: Vec<usize> = groups
+            .iter()
+            .filter(|(key, queue)| key.0 == active_flip && !queue.is_empty())
+            .filter_map(|(_, queue)| queue.front().copied())
+            .collect();
+
+        representatives.sort_by(|&left, &right| {
+            adaptive_family_order(parts, left, right, attempt + step)
+        });
+        representatives.dedup();
+
+        let mut best: Option<(Vec<i64>, Solution, usize)> = None;
+        for part_index in representatives.iter().copied() {
+            if Instant::now() >= deadline {
+                return Ok(None);
+            }
+            let mut trial = solution.clone();
+            if !place_part_best_probe(
+                parts,
+                cfg,
+                container,
+                &mut trial,
+                part_index,
+                cap,
+                attempt + step,
+            ) {
+                continue;
+            }
+            let rank = adaptive_trial_rank(parts, cfg, &solution, &trial, part_index);
+            if best
+                .as_ref()
+                .is_none_or(|current| rank.as_slice() < current.0.as_slice())
+            {
+                best = Some((rank, trial, part_index));
+            }
+        }
+
+        // Probe search is deliberately small. Before declaring a hard-cap
+        // failure, retry each active family with the full Jagua candidate set.
+        if best.is_none() {
+            for part_index in representatives.iter().copied() {
+                if Instant::now() >= deadline {
+                    return Ok(None);
+                }
+                let mut trial = solution.clone();
+                if !place_part_best(
+                    parts,
+                    cfg,
+                    container,
+                    &mut trial,
+                    part_index,
+                    cap,
+                    attempt + step,
+                ) {
+                    continue;
+                }
+                let rank = adaptive_trial_rank(parts, cfg, &solution, &trial, part_index);
+                if best
+                    .as_ref()
+                    .is_none_or(|current| rank.as_slice() < current.0.as_slice())
+                {
+                    best = Some((rank, trial, part_index));
+                }
+            }
+        }
+
+        let Some((_, trial, selected)) = best else {
+            return Ok(None);
+        };
+        solution = trial;
+        let flip_class = usize::from(!(cfg.optimize_flip_face && parts[selected].part.two_sided));
+        let key = (flip_class, parts[selected].shape_key);
+        let removed = groups.get_mut(&key).and_then(VecDeque::pop_front);
+        if removed != Some(selected) {
+            return Ok(None);
+        }
+        remaining -= 1;
+        step += 1;
+    }
+
+    Ok(Some(solution))
+}
+
+fn adaptive_family_order(
+    parts: &[PreparedPart],
+    left: usize,
+    right: usize,
+    variant: usize,
+) -> std::cmp::Ordering {
+    let a = &parts[left].part;
+    let b = &parts[right].part;
+    let bbox_a = (a.width * a.height).max(1.0);
+    let bbox_b = (b.width * b.height).max(1.0);
+    let fill_a = a.area.max(0.0) / bbox_a;
+    let fill_b = b.area.max(0.0) / bbox_b;
+    match variant % 5 {
+        0 => b.area.total_cmp(&a.area),
+        1 => bbox_b.total_cmp(&bbox_a),
+        2 => fill_a.total_cmp(&fill_b).then(b.area.total_cmp(&a.area)),
+        3 => a.area.total_cmp(&b.area),
+        _ => (parts[left].shape_key ^ variant as u64)
+            .cmp(&(parts[right].shape_key ^ variant as u64)),
+    }
+    .then(a.order.cmp(&b.order))
+}
+
+fn adaptive_trial_rank(
+    parts: &[PreparedPart],
+    cfg: &Config,
+    before: &Solution,
+    after: &Solution,
+    part_index: usize,
+) -> Vec<i64> {
+    let target_sheet = (0..after.sheets.len())
+        .find(|&index| {
+            after.sheets[index].placements.len()
+                > before.sheets.get(index).map_or(0, |sheet| sheet.placements.len())
+        })
+        .unwrap_or(after.sheets.len().saturating_sub(1));
+    let opened_sheet = i64::from(after.sheets.len() > before.sheets.len());
+    let sheet = &after.sheets[target_sheet];
+    let board_area = (cfg.board_width * cfg.board_height).max(1.0);
+    let utilization = sheet_area(parts, sheet) / board_area * 100.0;
+    let utilization_deficit = (TARGET_UTILIZATION - utilization).max(0.0);
+    let (right, top) = sheet_extent(parts, sheet);
+    let compact_area = (right - cfg.edge_margin).max(0.0)
+        * (top - cfg.edge_margin).max(0.0);
+    let cavity_waste = (compact_area - sheet_area(parts, sheet)).max(0.0);
+    let sheet_score = single_sheet_score(parts, cfg, sheet);
+
+    vec![
+        opened_sheet,
+        target_sheet as i64,
+        scaled(utilization_deficit),
+        scaled(cavity_waste),
+        sheet_score.1,
+        sheet_score.2,
+        scaled(-parts[part_index].part.area.max(0.0)),
+    ]
+}
