+fn repack_fragmented_tail(
+    parts: &[PreparedPart],
+    cfg: &Config,
+    container: &Container,
+    best: &mut Solution,
+    lower_bound: usize,
+    deadline: Instant,
+    runner: &Runner,
+) -> anyhow::Result<()> {
+    if best.sheets.len() <= lower_bound || Instant::now() >= deadline {
+        return Ok(());
+    }
+
+    let original = best.clone();
+    let mut cut_candidates = Vec::new();
+    let dense_prefix = original
+        .sheets
+        .iter()
+        .take_while(|sheet| sheet_utilization(parts, cfg, sheet) >= 75.0)
+        .count();
+    if dense_prefix > 0 && dense_prefix < original.sheets.len() {
+        cut_candidates.push(dense_prefix);
+    }
+    if original.sheets.len() > 6 {
+        cut_candidates.push(3.min(original.sheets.len() - 1));
+    }
+    cut_candidates.push(0);
+    cut_candidates.sort_unstable();
+    cut_candidates.dedup();
+    cut_candidates.sort_unstable_by(|a, b| b.cmp(a));
+
+    for cut in cut_candidates {
+        if Instant::now() >= deadline || best.sheets.len() <= lower_bound {
+            break;
+        }
+        let remaining: Vec<usize> = original.sheets[cut..]
+            .iter()
+            .flat_map(|sheet| sheet.placements.iter().map(|placed| placed.part_index))
+            .collect();
+        if remaining.is_empty() {
+            continue;
+        }
+
+        for variant in 0..ADAPTIVE_VARIANTS {
+            if runner.cancelled() {
+                anyhow::bail!("CANCELLED");
+            }
+            if Instant::now() >= deadline || best.sheets.len() <= lower_bound {
+                break;
+            }
+            let fixed = original.sheets[..cut].to_vec();
+            let mut candidate = pack_subset_sheet_by_sheet(
+                parts,
+                cfg,
+                container,
+                fixed,
+                &remaining,
+                variant,
+                deadline,
+                runner,
+            )?;
+            candidate.strategy = format!("mn_tail_family_cut_{cut}_variant_{variant}");
+            candidate.attempt = variant;
+
+            if solution_score(parts, cfg, &candidate).tuple()
+                < solution_score(parts, cfg, best).tuple()
+            {
+                *best = candidate;
+            }
+        }
+    }
+    Ok(())
+}
